{
    "name": "atoum-next/atoum-bundle",
    "description": "Bundle around atoum unit testing framework",
    "type": "symfony-bundle",
    "keywords": ["atoum", "atoum-next", "test", "unit testing"],
    "homepage": "https://github.com/AtoumNext/AtoumBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Florian Lonqueu-Brochard",
            "email": "dev@florianlb.fr"
        },
        {
            "name": "Community contributors",
            "homepage": "https://github.com/AtoumNext/AtoumBundle/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/finder": "^7.4 || ^8.0",
        "symfony/dom-crawler": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "atoum-next/atoum": "^5.0",
        "fakerphp/faker": "^1.23",
        "ext-dom": "*"
    },
    "require-dev": {
        "symfony/form": "^7.4 || ^8.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "rector/rector": "^2.0",
        "atoum/stubs": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "atoum\\AtoumBundle\\": "",
            "atoum\\AtoumBundle\\PHPStan\\": "phpstan/"
        }
    },
    "config": {
        "bin-dir": "bin"
    },
    "scripts": {
        "test": "php bin/atoum",
        "test-coverage": "php bin/atoum --enable-branch-and-path-coverage",
        "test-coverage-html": "php bin/atoum --enable-branch-and-path-coverage --coverage-html coverage",
        "test-no-coverage": "php bin/atoum --no-code-coverage",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.x-dev"
        },
        "symfony": {
            "allow-contrib": true,
            "require": "^7.4 || ^8.0"
        }
    }
}
